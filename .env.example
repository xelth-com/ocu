# ─── OCU API facade — environment configuration ─────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Comma-separated list of accepted API keys. Callers authenticate with
# `Authorization: Bearer <key>`. Generate long random strings, one per consumer.
OCU_API_KEYS=changeme-key-1,changeme-key-2

# Which backend driver to use: "scraper" (headless-browser adapter against the
# OPAL portal, the default) or "db" (native SQL driver — not implemented yet).
DRIVER=scraper

# Port the HTTP server listens on.
PORT=38300

# ─── OPAL portal (only used by the "scraper" driver) ─────────────────────────
# Base URL of the OPAL courier portal.
OPAL_URL=https://opal-kurier.de

# Portal login credentials. These are the courier account credentials, NOT the
# OCU API keys above.
OPAL_USERNAME=your-portal-username
OPAL_PASSWORD=your-portal-password

# Optional: directory for the Playwright persistent browser profile
# (cookies/session reuse). Defaults to ./.browser-data
# OPAL_USER_DATA_DIR=./.browser-data
